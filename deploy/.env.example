# Kopieren nach deploy/.env und ausfüllen. Die .env gehört NICHT ins Git.

# Langes, zufälliges Passwort für die Datenbank, z. B. mit:  openssl rand -base64 32
POSTGRES_PASSWORD=

# Adresse, unter der die App erreichbar ist
APP_URL=https://do-it.gerda-hilft.de

# Token aus Cloudflare Zero Trust → Networks → Tunnels → (Tunnel) → Docker-Befehl
CLOUDFLARE_TUNNEL_TOKEN=

# Wohin die nächtlichen Datenbank-Sicherungen geschrieben werden (am besten NFS/Backup-Share)
BACKUP_DIR=./backups
# Uhrzeit der Sicherung in UTC (02:15 UTC = 03:15 Winterzeit / 04:15 Sommerzeit)
BACKUP_TIME_UTC=02:15
BACKUP_KEEP_DAYS=14

# Optional: VAPID-Schlüssel und AUTH_SECRET werden sonst beim ersten Start erzeugt und in der DB gespeichert.
# AUTH_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@gerda-hilft.de

# Optional: höchstens so viele Anfragen pro Minute und IP (Schutz gegen Skripte)
# RATE_LIMIT_PER_MIN=600
